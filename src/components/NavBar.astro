---
// src/components/NavBar.astro
const { pathname } = Astro.url;

const links = [
  { href: "/research", label: "Research", match: ["/research", "/projects"] },
  { href: "/#path", label: "Path", match: [] },
  { href: "/#talks", label: "Papers & Talks", match: [] },
  { href: "/#contact", label: "Contact", match: [] },
];

const isActive = (match: string[]) => match.some((prefix) => pathname.startsWith(prefix));
---

<header class="navbar" id="site-navbar">
  <div class="navbar-inner">
    <a class="navbar-brand" href="/">
      <img
        class="navbar-logo"
        src="/images/brand/ev-ribbons-transparent.webp"
        width="256"
        height="248"
        alt=""
        aria-hidden="true"
      />
      <span>Emma Vellard</span>
    </a>

    <div class="navbar-right">
      <nav class="navbar-links" aria-label="Main navigation">
        {
          links.map((l) => (
            <a class="nav-link" href={l.href} aria-current={isActive(l.match) ? "page" : undefined}>
              {l.label}
            </a>
          ))
        }
        <a class="nav-link nav-cv" href="/files/cv_vellard.pdf" download="Emma-Vellard-CV.pdf">CV ↓</a>
      </nav>

      <button class="icon-btn theme-toggle" type="button" aria-label="Switch to dark mode">
        <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
        <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
          <path
            d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"></path>
        </svg>
      </button>

      <button
        class="icon-btn nav-burger"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-inner" role="dialog" aria-modal="true" aria-label="Menu" tabindex="-1">
    <button class="icon-btn mobile-close" type="button" aria-label="Close menu">
      <span aria-hidden="true">×</span>
    </button>

    <nav class="mobile-links" aria-label="Mobile navigation">
      {
        links.map((l) => (
          <a class="mobile-link" href={l.href} aria-current={isActive(l.match) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="mobile-link" href="/files/cv_vellard.pdf" download="Emma-Vellard-CV.pdf">Download CV</a>
    </nav>
  </div>
</div>

<script>
  // bindNavbar can run several times (initial load and Astro page events), so each
  // run aborts the listeners registered by the previous one.
  let listeners: AbortController | null = null;

  const bindNavbar = () => {
    listeners?.abort();
    listeners = new AbortController();
    const { signal } = listeners;

    const root = document.documentElement;
    const themeBtn = document.querySelector<HTMLButtonElement>(".theme-toggle");

    const syncThemeButton = () => {
      const dark = root.dataset.theme === "dark";
      themeBtn?.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
    };
    syncThemeButton();

    themeBtn?.addEventListener(
      "click",
      () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage can be unavailable (private mode); the choice then lasts for this page only.
        }
        syncThemeButton();
      },
      { signal },
    );

    const nav = document.getElementById("site-navbar");
    const btn = nav?.querySelector<HTMLButtonElement>(".nav-burger");
    const menu = document.getElementById("mobile-menu");
    const dialog = menu?.querySelector<HTMLElement>(".mobile-menu-inner");
    const closeBtn = menu?.querySelector<HTMLButtonElement>(".mobile-close");

    if (!nav || !btn || !menu || !dialog) return;

    let restoreFocus: HTMLElement | null = null;

    const setA11y = (isOpen: boolean) => {
      btn.setAttribute("aria-expanded", String(isOpen));
      btn.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
      menu.setAttribute("aria-hidden", String(!isOpen));
    };

    const close = ({ returnFocus = true }: { returnFocus?: boolean } = {}) => {
      const wasOpen = nav.classList.contains("menu-open");
      nav.classList.remove("menu-open");
      setA11y(false);
      document.documentElement.classList.remove("no-scroll");

      if (wasOpen && returnFocus && restoreFocus instanceof HTMLElement) {
        restoreFocus.focus({ preventScroll: true });
      }
    };

    const open = () => {
      const scrollPosition = window.scrollY;
      restoreFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      nav.classList.add("menu-open");
      setA11y(true);
      // Lock only the root: locking body also breaks the navbar's sticky scroll container.
      document.documentElement.classList.add("no-scroll");

      const firstLink = dialog.querySelector("a");
      if (firstLink instanceof HTMLElement) firstLink.focus({ preventScroll: true });
      else dialog.focus({ preventScroll: true });
      window.scrollTo({ top: scrollPosition, behavior: "instant" });
    };

    btn.addEventListener("click", () => (nav.classList.contains("menu-open") ? close() : open()), {
      signal,
    });
    closeBtn?.addEventListener("click", () => close(), { signal });

    menu.addEventListener(
      "click",
      (e) => {
        if (e.target === menu) close();
      },
      { signal },
    );

    menu
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", () => close({ returnFocus: false }), { signal }));

    const onKeydown = (e: KeyboardEvent) => {
      if (!nav.classList.contains("menu-open")) return;

      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }

      if (e.key !== "Tab") return;

      const focusable = Array.from(
        dialog.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => element.offsetParent !== null);

      if (!focusable.length) {
        e.preventDefault();
        dialog.focus();
        return;
      }

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    window.addEventListener("keydown", onKeydown, { signal });
    window.addEventListener(
      "resize",
      () => {
        if (window.innerWidth > 860) close({ returnFocus: false });
      },
      { signal },
    );
  };

  document.addEventListener("astro:page-load", bindNavbar);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindNavbar);
  } else {
    bindNavbar();
  }
</script>
