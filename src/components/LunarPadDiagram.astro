<svg
  class="spaceport-pad-diagram"
  viewBox="0 0 600 500"
  role="img"
  aria-labelledby="spaceport-pad-title"
  aria-describedby="spaceport-pad-description"
>
  <title id="spaceport-pad-title">Simplified plan of the proposed lunar landing pad</title>
  <desc id="spaceport-pad-description"
    >A circular paved surface is surrounded by an outer berm and contains four curved internal berms. Numbers
    identify the outer berm, internal berms and regolith pavement. This conceptual plan is not to scale, is
    adapted from Figure 1.9 of the ISU team report and does not show simulated exhaust flow.</desc
  >
  <text x="300" y="29" text-anchor="middle" class="pad-caption">PLAN VIEW · SCHEMATIC</text>
  <circle class="pad-floor" cx="300" cy="242" r="164"></circle>
  <circle class="pad-outer-berm" cx="300" cy="242" r="185"></circle>
  <circle class="pad-rim-line" cx="300" cy="242" r="199"></circle>
  <circle class="pad-rim-line" cx="300" cy="242" r="171"></circle>
  {
    [0, 90, 180, 270].map((angle) => (
      <path
        class="pad-inner-berm"
        transform={"rotate(" + angle + " 300 242)"}
        d="M259 157 C283 132 331 132 351 167 Q319 149 293 180 Q276 173 259 157Z"
      />
    ))
  }
  <circle class="pad-centre-guide" cx="300" cy="242" r="38"></circle>
  <path class="pad-centre-guide" d="M289 242h22M300 231v22"></path>
  <g class="pad-callout">
    <circle cx="482" cy="242" r="15"></circle><text x="482" y="247" text-anchor="middle">1</text>
    <circle cx="309" cy="155" r="15"></circle><text x="309" y="160" text-anchor="middle">2</text>
    <circle cx="257" cy="304" r="15"></circle><text x="257" y="309" text-anchor="middle">3</text>
  </g>
  <text x="300" y="478" text-anchor="middle" class="pad-caption">LAYOUT ONLY · NOT TO SCALE</text>
</svg>
