---
import { decorations } from "../data/decorations";
import IllustratedLink from "./IllustratedLink.astro";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container site-footer-main">
    <div class="site-footer-text">
      <h2 class="site-footer-title">Let's talk about the Moon.</h2>
      <p class="site-footer-lede">
        Collaborations, research discussions, or a question about this work — email is the best way to reach
        me.
      </p>
      <p class="site-footer-links">
        <IllustratedLink variant="contact" class="site-footer-email" href="mailto:emma.vellard@outlook.fr"
          >emma.vellard@outlook.fr</IllustratedLink
        >
        <a
          class="hover-ul"
          href="https://www.linkedin.com/in/emma-vellard"
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        >
        <a class="hover-ul" href="https://github.com/EmmaVellard" target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
      </p>
    </div>
    <div class="site-footer-mark">
      <img
        class="site-footer-character"
        {...decorations.explorer}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
      <p class="site-footer-signature" aria-hidden="true">Emma</p>
    </div>
  </div>

  <div class="container site-footer-bottom">
    <span>© {currentYear} Emma Vellard</span>
  </div>
</footer>
