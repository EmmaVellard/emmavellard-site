---
import "../styles/home.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/NavBar.astro";
---

<BaseLayout
  title="Emma Vellard | Lunar & Planetary Scientist"
  description="Planetary scientist and space systems engineer working across lunar science, scientific instrumentation, mission data and research software at NASA JPL and ESA."
>
  <Navbar />

  <main class="hero" id="main-content" tabindex="-1">
    <div class="hero-bg"></div>

    <div class="container hero-content">
      <p class="hero-kicker">Currently at NASA JPL · Previously at ESA</p>

      <h1 class="hero-title">
        <strong>Lunar & Planetary Scientist</strong> and
        <br />
        <strong>Space Systems Engineer</strong>.
      </h1>

      <p class="hero-lead">
        I connect planetary science questions with mission-relevant measurements,
        scientific instrumentation, data, and research software.
      </p>

      <div class="hero-proof" aria-label="Professional focus">
        <span>NASA JPL</span>
        <span>ESA</span>
        <span>Lunar science</span>
        <span>Scientific instrumentation</span>
      </div>

      <div class="hero-ctas">
        <a class="link-btn link-btn--primary" href="/experience">View my experience</a>
        <a class="link-btn" href="/projects">Selected projects</a>
        <a class="link-btn link-btn--secondary" href="/files/cv_vellard.pdf" target="_blank" rel="noopener">Download CV</a>
      </div>
    </div>

    <p class="hero-caption">
      Earth image captured by YPSat during Ariane 6’s maiden flight.
    </p>
  </main>
</BaseLayout>
