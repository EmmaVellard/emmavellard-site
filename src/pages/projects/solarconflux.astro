---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IllustratedLink from "../../components/IllustratedLink.astro";
import SolarGeometry from "../../components/SolarGeometry.astro";
import { projects } from "../../data/projects";
import "../../styles/research.css";
import "../../styles/projects.css";
import "../../styles/solarconflux.css";

const sourceRevision = "bcca574095b0a95733295e1937775e6380dd36d8";
const dataSource = `https://github.com/EmmaVellard/SolarConflux/blob/${sourceRevision}/web/example.json`;
const previous = projects[projects.length - 1];
const next = projects[1];
const steps = [
  {
    title: "Retrieve trajectories",
    text: "Choose spacecraft, planets, dates and sampling. Express the ephemerides in a common Sun-centred frame.",
  },
  {
    title: "Compare geometries",
    text: "Screen circular longitude separations or ballistic Parker footpoints, with an optional group latitude filter.",
  },
  {
    title: "Find windows",
    text: "Group successive matching samples into candidate intervals. Their boundaries follow the sampling cadence.",
  },
  {
    title: "Keep the context",
    text: "Export the windows, settings and data provenance alongside plots for further investigation.",
  },
];
const geometries = [
  { mode: "cone", title: "Cone", text: "When are observers close in longitude to an anchor body?" },
  { mode: "opposition", title: "Opposition", text: "When are two observers about 180° apart in longitude?" },
  { mode: "quadrature", title: "Quadrature", text: "When are two observers about 90° apart in longitude?" },
  { mode: "arbitrary", title: "Custom angle", text: "When does their separation approach a chosen angle?" },
  { mode: "parker", title: "Parker spiral", text: "When do approximate ballistic source longitudes agree?" },
  { mode: "coneparker", title: "Cone + Parker", text: "When do the sector and Parker criteria both hold?" },
] as const;
---

<BaseLayout
  title="SolarConflux | Emma Vellard"
  description="SolarConflux is Emma Vellard's open-source research tool for finding candidate coordinated-observation windows from spacecraft ephemerides and approximate heliocentric geometries."
  socialImage="/images/projects/solarconflux/solar-viewpoints.webp"
  socialImageAlt="Paper illustration of the Sun seen from three spacecraft viewpoints"
  socialImageWidth={1536}
  socialImageHeight={1024}
>
  <main id="main-content" class="solar-project" tabindex="-1">
    <section class="container research-intro solar-intro">
      <a class="text-link solar-back" href="/research#earlier">← Research</a>
      <div class="solar-hero">
        <div>
          <p class="eyebrow eyebrow--plain">Earlier work · Research software</p>
          <h1 class="research-title">SolarConflux</h1>
          <p class="solar-question">One Sun. Several spacecraft. When do their viewpoints align?</p>
          <p class="research-intro-text muted">
            I built SolarConflux to turn spacecraft trajectories into <strong class="text-emphasis"
              >candidate observation windows</strong
            >. It screens useful geometries for coordinated solar and heliospheric observations, then keeps
            the dates and assumptions together for follow-up analysis.
          </p>
          <dl class="project-facts solar-facts">
            <div><dt>My role</dt><dd>Designer &amp; developer</dd></div>
            <div><dt>Project context</dt><dd>ESA · 2023–2025</dd></div>
            <div><dt>Today</dt><dd>Open-source Python &amp; web explorer</dd></div>
          </dl>
          <div class="project-actions">
            <IllustratedLink href="https://emmavellard.github.io/SolarConflux/" external
              >Open the explorer</IllustratedLink
            >
            <IllustratedLink
              href="https://github.com/EmmaVellard/SolarConflux"
              variant="document"
              illustration={{
                src: "/images/projects/solarconflux/github-cat.webp",
                width: 240,
                height: 240,
              }}
              external>View on GitHub</IllustratedLink
            >
          </div>
        </div>
        <img
          class="solar-hero-art float-art"
          src="/images/projects/solarconflux/solar-viewpoints.webp"
          width="1536"
          height="1024"
          alt="Conceptual paper illustration of the Sun surrounded by three spacecraft at different viewpoints"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <nav class="research-index" aria-label="On this page" data-section-nav>
        <span class="research-index-label">On this page</span>
        <a class="text-link" href="#question">The question</a>
        <a class="text-link" href="#approach">Approach</a>
        <a class="text-link" href="#example">Worked example</a>
        <a class="text-link" href="#use">Explore the tool</a>
      </nav>
    </section>

    <section class="solar-chapter band" id="question" aria-labelledby="question-title">
      <div class="container">
        <p class="eyebrow eyebrow--plain">The question</p>
        <h2 class="h2" id="question-title">A shared view starts with geometry.</h2>
        <div class="chapter-pair solar-question-pair">
          <div>
            <p class="solar-lede">
              Spacecraft sample the heliosphere from different places. Their <strong class="text-emphasis"
                >relative positions</strong
              > help determine which measurements may be useful together, whether for comparing viewpoints or investigating
              how solar-wind structures evolve with distance.
            </p>
            <p class="muted">
              Searching many trajectories by hand quickly becomes cumbersome. SolarConflux asks a simpler
              first question: when do the selected bodies satisfy a geometry worth investigating?
            </p>
          </div>
          <aside class="chapter-note solar-contribution">
            <h3 class="chapter-note-term">What I contributed</h3>
            <ul>
              <li>Designed the workflow from ephemeris retrieval to export.</li>
              <li>Implemented six geometric and Parker screening modes.</li>
              <li>Presented the tool to the BepiColombo Science Working Team.</li>
            </ul>
          </aside>
        </div>
        <div class="model-comparison solar-thread">
          <div class="model-comparison-copy">
            <p class="eyebrow eyebrow--plain">From positions to possibilities</p>
            <p class="chapter-quote">Find the geometry first. Interpret it with the observations.</p>
            <p class="muted model-comparison-detail">
              An alignment is a <strong class="text-emphasis">starting point for analysis</strong>. It helps
              shortlist dates; measurements and physical models are needed to establish what the spacecraft
              actually share.
            </p>
          </div>
          <figure class="model-comparison-art solar-window-art">
            <img
              src="/images/projects/solarconflux/observation-windows.webp"
              width="1916"
              height="821"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span>Trajectories → candidate windows</span><small>Conceptual illustration</small>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="solar-chapter" id="approach" aria-labelledby="approach-title">
      <div class="container">
        <p class="eyebrow eyebrow--plain">Approach</p>
        <h2 class="h2" id="approach-title">From ephemerides to a shortlist.</h2>
        <ol class="pipeline">
          {
            steps.map((step, index) => (
              <li>
                <>
                  <span class="pipeline-num" aria-hidden="true">
                    {index + 1}
                  </span>
                  <span class="pipeline-title">{step.title}</span>
                  <span class="pipeline-text muted">{step.text}</span>
                </>
              </li>
            ))
          }
        </ol>
        <h3 class="research-h3 chapter-sub">Different geometries, different questions.</h3>
        <ul class="solar-geometries">
          {
            geometries.map((geometry) => (
              <li>
                <>
                  <SolarGeometry mode={geometry.mode} />
                  <div>
                    <>
                      <h4>{geometry.title}</h4>
                      <p class="muted">{geometry.text}</p>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ul>
        <p class="solar-small-note muted">
          Diagrams are conceptual. The geometric modes compare longitude; latitude can be filtered separately.
          Groups share an anchor body; not every pair in a group necessarily meets the criterion. Parker modes
          use a simplified ballistic approximation.
        </p>
      </div>
    </section>

    <section class="solar-chapter band" id="example" aria-labelledby="example-title">
      <div class="container">
        <p class="eyebrow eyebrow--plain">A worked example · January 2025</p>
        <h2 class="h2" id="example-title">What does a candidate window look like?</h2>
        <p class="solar-section-lede muted">
          The bundled example contains <strong class="text-emphasis"
            >Earth, Solar Orbiter and BepiColombo</strong
          >. Here, a 15° cone criterion with a 10° latitude-span limit selects one interval for Earth and
          Solar Orbiter. BepiColombo is shown for context and does not belong to that matched pair.
        </p>
        <dl class="solar-example-facts">
          <div><dt>Matching pair</dt><dd>Earth + Solar Orbiter</dd></div>
          <div><dt>Candidate interval · UTC</dt><dd>1 Jan 00:00 → 7 Jan 18:00</dd></div>
          <div><dt>Sample spacing</dt><dd>6 hours</dd></div>
          <div><dt>Sampled duration</dt><dd>162 hours</dd></div>
        </dl>
        <div class="solar-charts">
          <figure>
            <h3 class="research-h3">Where the observers are</h3>
            <div class="solar-chart">
              <a
                class="solar-chart-light"
                href="/images/projects/solarconflux/january-2025-positions-light.svg"
                target="_blank"
                rel="noopener"
                aria-label="Open the positions figure at full size"
                ><img
                  src="/images/projects/solarconflux/january-2025-positions-light.svg"
                  width="650"
                  height="460"
                  alt="Sun-centred positions on 1 January 2025, with a 15-degree longitude sector containing Earth and Solar Orbiter; BepiColombo lies outside it"
                  loading="lazy"
                /></a
              >
              <a
                class="solar-chart-dark"
                href="/images/projects/solarconflux/january-2025-positions-dark.svg"
                target="_blank"
                rel="noopener"
                aria-label="Open the positions figure at full size"
                ><img
                  src="/images/projects/solarconflux/january-2025-positions-dark.svg"
                  width="650"
                  height="460"
                  alt="Sun-centred positions on 1 January 2025, with a 15-degree longitude sector containing Earth and Solar Orbiter; BepiColombo lies outside it"
                  loading="lazy"
                /></a
              >
            </div>
            <figcaption>
              Markers show 1 January, 00:00 UTC. Lines join the retrieved samples through 15 January.
              Heliocentric inertial coordinates, projected into the solar equatorial plane; distances in AU.
              Select the figure to open it at full size.
            </figcaption>
          </figure>
          <figure>
            <h3 class="research-h3">When the criterion holds</h3>
            <div class="solar-chart">
              <a
                class="solar-chart-light"
                href="/images/projects/solarconflux/january-2025-separation-light.svg"
                target="_blank"
                rel="noopener"
                aria-label="Open the longitude-separation figure at full size"
                ><img
                  src="/images/projects/solarconflux/january-2025-separation-light.svg"
                  width="650"
                  height="460"
                  alt="Earth–Solar Orbiter circular longitude separation crosses the 15-degree criterion after 7 January at 18:00 UTC; 28 samples meet the criterion"
                  loading="lazy"
                /></a
              >
              <a
                class="solar-chart-dark"
                href="/images/projects/solarconflux/january-2025-separation-dark.svg"
                target="_blank"
                rel="noopener"
                aria-label="Open the longitude-separation figure at full size"
                ><img
                  src="/images/projects/solarconflux/january-2025-separation-dark.svg"
                  width="650"
                  height="460"
                  alt="Earth–Solar Orbiter circular longitude separation crosses the 15-degree criterion after 7 January at 18:00 UTC; 28 samples meet the criterion"
                  loading="lazy"
                /></a
              >
            </div>
            <figcaption>
              The shaded interval spans the first to last matching sample. All 28 matching samples also meet
              the latitude-span limit. The next sample, on 8 January at 00:00 UTC, lies outside the cone.
              Select the figure to open it at full size.
            </figcaption>
          </figure>
        </div>
        <p class="research-scope muted solar-cadence-note">
          These are <strong class="text-emphasis">sampled boundaries</strong>, not exact entry and exit times.
          The interval begins at the first requested sample, so an earlier start is not inferred. The plots
          illustrate a geometry, not confirmed shared plasma or magnetic connectivity.
        </p>
        <div class="solar-data-links">
          <span>Inspect the example</span>
          <a class="text-link" href={dataSource} target="_blank" rel="noopener">Source ephemerides</a>
          <a class="text-link" href="/files/solarconflux/january-2025-samples.csv" download
            >Sample values · CSV</a
          >
          <a class="text-link" href="/files/solarconflux/january-2025-provenance.json" download
            >Provenance · JSON</a
          >
        </div>
      </div>
    </section>

    <section class="solar-chapter" id="use" aria-labelledby="use-title">
      <div class="container">
        <p class="eyebrow eyebrow--plain">The tool today</p>
        <h2 class="h2" id="use-title">Explore, inspect, keep the context.</h2>
        <div class="chapter-pair solar-use-pair">
          <div>
            <p class="solar-lede">
              The web explorer makes the workflow visible: configure observation periods, follow trajectories,
              inspect matching intervals and export the results. Saved runs can be reopened in{" "}
              <strong class="text-emphasis">History</strong> on the same browser.
            </p>
            <p class="muted">
              The bundled example and imported trajectories can be screened without live retrieval. Live
              ephemerides are retrieved through a separate service; availability depends on the selected
              bodies, dates and data source.
            </p>
            <div class="project-actions">
              <IllustratedLink href="#example">View the January example</IllustratedLink>
            </div>
          </div>
          <aside class="chapter-note">
            <h3 class="chapter-note-term">A shortlist for follow-up</h3>
            <p class="muted">
              Parker screening maps approximate source longitudes using an assumed uniform solar-wind speed.
              Its results depend on those assumptions; they do not establish magnetic connectivity.
              SolarConflux remains a <strong class="text-emphasis">research prototype</strong>.
            </p>
          </aside>
        </div>
        <dl class="chapter-facts">
          <div><dt>Tools</dt><dd>Python · SunPy · Astropy · Astroquery · NumPy · Matplotlib</dd></div>
          <div>
            <dt>Data</dt><dd>JPL Horizons · SPICE kernels where available · imported trajectories</dd>
          </div>
          <div>
            <dt>Outputs</dt><dd>Candidate-window CSVs · run metadata · plots · browser run backups</dd>
          </div>
        </dl>
        <div class="solar-data-links solar-sources">
          <span>Method notes</span>
          <a
            class="text-link"
            href="https://github.com/EmmaVellard/SolarConflux/blob/main/docs/scientific_validation.md"
            target="_blank"
            rel="noopener">Scientific assumptions</a
          >
          <a
            class="text-link"
            href="https://github.com/EmmaVellard/SolarConflux/blob/main/docs/parker_spiral_convention.md"
            target="_blank"
            rel="noopener">Parker convention</a
          >
        </div>
        <details class="project-details solar-details">
          <summary
            ><span class="project-details-title">Python usage &amp; original quick-look figures</span><span
              class="project-details-toggle"
              aria-hidden="true"></span></summary
          >
          <div class="project-details-body">
            <div>
              <h3>Use the Python package</h3>
              <pre
                class="project-code"><code>pip install git+https://github.com/EmmaVellard/SolarConflux.git</code></pre>
              <p>
                The command-line workflow exposes the same screening modes and exports CSVs, run metadata and
                optional polar plots.
              </p>
              <a
                class="text-link"
                href="https://github.com/EmmaVellard/SolarConflux#cli-quickstart"
                target="_blank"
                rel="noopener">Installation &amp; examples</a
              >
            </div>
            <div>
              <h3>Earlier output figures</h3>
              <p>
                The original cone and Parker quick-look plots remain available. The figures above use the
                documented January dataset so their inputs and styling can be reproduced.
              </p>
              <div class="solar-archive-links">
                <a
                  class="text-link"
                  href="/images/projects/solarconflux/cone-alignments.webp"
                  target="_blank"
                  rel="noopener">Original cone plots</a
                >
                <a
                  class="text-link"
                  href="/images/projects/solarconflux/parker-alignments.webp"
                  target="_blank"
                  rel="noopener">Original Parker plots</a
                >
              </div>
            </div>
          </div>
        </details>
      </div>
    </section>

    <nav class="container project-pager" aria-label="More projects">
      <a class="project-pager-link" href={`/projects/${previous.slug}`}>
        <img class="float-art" {...previous.illustration} alt="" loading="lazy" decoding="async" />
        <span
          ><span class="project-pager-k">← Previous</span><span class="project-pager-v">{previous.title}</span
          ></span
        >
      </a>
      <a class="project-pager-link project-pager-link--next" href={`/projects/${next.slug}`}>
        <span
          ><span class="project-pager-k">Next →</span><span class="project-pager-v">{next.title}</span></span
        >
        <img class="float-art" {...next.illustration} alt="" loading="lazy" decoding="async" />
      </a>
    </nav>
  </main>
</BaseLayout>
