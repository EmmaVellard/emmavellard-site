---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/NavBar.astro";
import "../styles/conferences.css";
---

<BaseLayout
  title="Conferences | Emma Vellard"
  description="Selected talks, posters, and submitted research by Emma Vellard at planetary science conferences and ESA science working team meetings."
>
  <Navbar />

  <main class="page page-conferences" id="main-content" tabindex="-1">
    <div class="conf-bg" aria-hidden="true"></div>

    <section class="conf-shell">
      <div class="container">
        <header class="conf-head">
          <h1 class="conf-title">Conferences</h1>
          <p class="conf-sub">
            Selected meetings and talks, presented as a constellation of milestones.
          </p>
        </header>

        <section class="conf-orbit" aria-label="Conference constellation">
          <div class="conf-orbit-line" aria-hidden="true"></div>

          <div class="conf-year-down conf-year-start">2026</div>
          <div class="conf-year-up conf-year-end">2024</div>

          <!-- Dots placed on the orbit line (desktop) -->
          <span class="conf-dot" style="--x: 18%;" aria-hidden="true"></span>
          <span class="conf-dot" style="--x: 34%;" aria-hidden="true"></span>
          <span class="conf-dot" style="--x: 50%;" aria-hidden="true"></span>
          <span class="conf-dot" style="--x: 66%;" aria-hidden="true"></span>
          <span class="conf-dot" style="--x: 82%;" aria-hidden="true"></span>

          <!-- 2026 DPS -->
          <article class="conf-node conf-node--top" style="--x: 18%;">
            <span class="conf-node-dot" aria-hidden="true"></span>

            <div class="conf-content conf-glass">
              <div class="conf-meta">
                <span class="conf-year">2026</span>
                <span class="conf-sep">·</span>
                <span class="conf-place">United States</span>
              </div>

              <h2 class="conf-h2">AAS Division for Planetary Sciences Meeting</h2>

              <p class="conf-text">
                <span class="conf-label">Submitted abstract</span><br />
                Lunar interior modelling and <span class="hl">bulk-silicate mantle compositions</span>.
              </p>
            </div>
          </article>

          <!-- 2025 -->
          <article class="conf-node conf-node--bottom" style="--x: 34%;">
            <!-- Mobile dot (on vertical line) -->
            <span class="conf-node-dot" aria-hidden="true"></span>

            <div class="conf-content conf-glass">
              <div class="conf-meta">
                <span class="conf-year">2025</span>
                <span class="conf-sep">·</span>
                <span class="conf-place">Italy</span>
              </div>

              <h2 class="conf-h2">BepiColombo Science Working Team</h2>

              <p class="conf-text">
                <span class="conf-label">Talk</span><br />
                <a class="conf-inline-link" href="/projects/solarconflux">SolarConflux</a>: Coordinated heliophysics observation opportunities across multiple spacecraft using mission geometry analysis.
              </p>

            </div>
          </article>

          <!-- 2024 ASE -->
          <article class="conf-node conf-node--top" style="--x: 50%;">
            <span class="conf-node-dot" aria-hidden="true"></span>

            <div class="conf-content conf-glass">
              <div class="conf-meta">
                <span class="conf-year">2024</span>
                <span class="conf-sep">·</span>
                <span class="conf-place">Netherlands</span>
              </div>

              <h2 class="conf-h2">ASE Planetary Congress</h2>

              <p class="conf-text">
                <span class="conf-label">Talk</span><br />
                The Future of Space Exploration: Outreach presentation on future space missions, <span class="hl">lunar exploration</span>, and the role of the next generation of space professionals.
              </p>

            </div>
          </article>

          <!-- 2024 EPSC -->
          <article class="conf-node conf-node--bottom" style="--x: 66%;">
            <span class="conf-node-dot" aria-hidden="true"></span>

            <div class="conf-content conf-glass">
              <div class="conf-meta">
                <span class="conf-year">2024</span>
                <span class="conf-sep">·</span>
                <span class="conf-place">Germany</span>
              </div>

              <h2 class="conf-h2">Europlanet Science Congress (EPSC)</h2>

              <p class="conf-text">
                <span class="conf-label">Poster</span><br />
                JUICE Mission Preparation: Science operations, observation planning, and mission coordination for the <span class="hl">Jupiter Icy Moons Explorer</span>.
              </p>

            </div>
          </article>

          <!-- 2024 JUICE SWT -->
          <article class="conf-node conf-node--top" style="--x: 82%;">
            <span class="conf-node-dot" aria-hidden="true"></span>

            <div class="conf-content conf-glass">
              <div class="conf-meta">
                <span class="conf-year">2024</span>
                <span class="conf-sep">·</span>
                <span class="conf-place">Netherlands</span>
              </div>

              <h2 class="conf-h2">JUICE Science Working Team</h2>

              <p class="conf-text">
                <span class="conf-label">Talk</span><br />
                JUICE Mission Preparation: Science operations, observation planning, and mission coordination for the <span class="hl">Jupiter Icy Moons Explorer</span>.
              </p>

            </div>
          </article>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>
