---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/NavBar.astro";
import "../styles/projects.css";
---

<BaseLayout
  title="Projects | Emma Vellard"
  description="Explore Emma Vellard's work in lunar interiors, planetary instrumentation, scientific software, mission concepts, spectroscopy, and sustainable lunar exploration."
>
  <Navbar />

  <main class="page page-projects" id="main-content" tabindex="-1">
    <div class="projects-bg" aria-hidden="true"></div>

    <section class="projects-shell">
      <div class="container">
        <header class="projects-head">
          <h1 class="projects-title">Projects</h1>
          <p class="projects-sub">
            A selection of work connecting <span class="hl">planetary science</span>, <span class="hl"
              >measurements and instrumentation</span
            >, scientific software, and mission development.
          </p>

          <!-- quick index -->
          <nav class="projects-jump" aria-label="On this page">
            <a class="projects-jump-link" href="#featured">Featured</a>
            <a class="projects-jump-link" href="#lunar-science">Lunar science & instrumentation</a>
            <a class="projects-jump-link" href="#software">Scientific software</a>
            <a class="projects-jump-link" href="#contrib">Mission contributions</a>
          </nav>
        </header>

        <!-- FEATURED -->
        <section class="projects-featured" id="featured" aria-label="Featured project">
          <a
            class="proj-card proj-featured proj-card-link"
            id="lunar-interiors"
            href="/projects/lunar-interiors"
          >
            <div class="proj-featured-grid">
              <div class="proj-main">
                <div class="proj-kicker">Featured</div>
                <h2 class="proj-h2">Lunar interior modelling</h2>
                <div class="proj-subtle">Lunar geophysics · Scientific modelling · Future measurements</div>
                <p class="proj-desc">
                  Research at NASA JPL comparing <span class="hl">bulk-silicate Moon compositions</span> and evaluating
                  how future geophysical measurements could discriminate between interior scenarios.
                </p>

                <ul class="proj-bullets">
                  <li>Thermodynamic and geophysical models of lunar mantle structure and composition.</li>
                  <li>
                    Reproducible Python workflows with validation, assumptions, and limitations documented.
                  </li>
                  <li>
                    Direct connection between scientific hypotheses, observable quantities, and future
                    measurements.
                  </li>
                </ul>

                <div class="proj-actions">
                  <span class="link-btn"> View project </span>
                </div>
              </div>

              <aside class="proj-facts" aria-label="Project details">
                <div class="proj-facts-title">Quick facts</div>

                <div class="proj-fact">
                  <div class="proj-fact-label">Type</div>
                  <div class="proj-fact-value">Planetary science research</div>
                </div>

                <div class="proj-fact">
                  <div class="proj-fact-label">Focus</div>
                  <div class="proj-fact-value">Lunar interior and geophysical measurements</div>
                </div>

                <div class="proj-fact">
                  <div class="proj-fact-label">Stack</div>
                  <div class="proj-fact-value">Python · Perple_X · PlanetProfile</div>
                </div>

                <div class="proj-fact">
                  <div class="proj-fact-label">Context</div>
                  <div class="proj-fact-value">NASA Jet Propulsion Laboratory</div>
                </div>
              </aside>
            </div>
            <div class="proj-year">2026</div>
          </a>
        </section>

        <!-- LUNAR SCIENCE & INSTRUMENTATION -->
        <section class="projects-section" id="lunar-science" aria-label="Lunar science and instrumentation">
          <div class="projects-section-head">
            <h2 class="projects-h3">Lunar science and instrumentation</h2>
            <p class="projects-muted">
              Work connecting scientific questions to laboratory measurements, payload concepts, performance
              assessment, and exploration needs.
            </p>
          </div>

          <div class="proj-list proj-list-2">
            <a class="proj-card proj-item proj-card-link" id="ceres" href="/projects/ceres">
              <div class="proj-kicker">Instrumentation concept</div>
              <h3 class="proj-h3-item">Diplona</h3>
              <div class="proj-subtle">Mission concept · Radar sounder · Payload feasibility</div>
              <p class="proj-desc">
                A science-driven study translating <span class="hl">Ceres subsurface questions</span> into a radar
                measurement concept, preliminary payload sizing, and instrument-performance trade-offs.
              </p>
              <div class="proj-actions">
                <span class="link-btn">View project</span>
              </div>
              <div class="proj-year">2022</div>
            </a>

            <a class="proj-card proj-item proj-card-link" id="phobos-deimos" href="/projects/phobos-deimos">
              <div class="proj-kicker">Mission-oriented research</div>
              <h3 class="proj-h3-item">Phobos & Deimos</h3>
              <div class="proj-subtle">Laboratory spectroscopy · OROCHI · MIRS</div>
              <p class="proj-desc">
                Laboratory and spectral analysis of Phobos analogue samples, including outputs resampled to <span
                  class="hl">MMX instrument conditions</span
                > for mission-oriented interpretation.
              </p>
              <div class="proj-actions">
                <span class="link-btn">View project</span>
              </div>
              <div class="proj-year">2023</div>
            </a>
          </div>
        </section>

        <!-- SCIENTIFIC SOFTWARE -->
        <section class="projects-section" id="software" aria-label="Scientific software">
          <div class="projects-section-head">
            <h2 class="projects-h3">Scientific software</h2>
            <p class="projects-muted">
              Selected open-source work supporting scientific analysis and mission planning.
            </p>
          </div>

          <div class="proj-list">
            <a class="proj-card proj-item proj-card-link" id="solarconflux" href="/projects/solarconflux">
              <div class="proj-kicker">Selected project</div>
              <h3 class="proj-h3-item">SolarConflux</h3>
              <div class="proj-subtle">Scientific software · Mission analysis · Observation planning</div>
              <p class="proj-desc">
                Open-source Python software identifying <span class="hl"
                  >coordinated observation opportunities</span
                > across more than 20 space missions using spacecraft geometry and configurable science scenarios.
              </p>

              <div class="proj-actions">
                <span class="link-btn"> View project </span>
              </div>
              <div class="proj-year">2023–2025</div>
            </a>
          </div>
        </section>

        <!-- CONTRIBUTIONS -->
        <section class="projects-section" id="contrib" aria-label="Mission and research contributions">
          <div class="projects-section-head">
            <h2 class="projects-h3">Mission and research contributions</h2>
            <p class="projects-muted">Applied research and mission-focused developments.</p>
          </div>

          <div class="proj-list proj-list-2">
            <article class="proj-card proj-item" id="juice">
              <h3 class="proj-h3-item">JUICE</h3>
              <div class="proj-subtle">Mission analysis · Data readiness · Science operations support</div>
              <p class="proj-desc">
                A centralised scientific data and knowledge platform supporting mission preparation,
                traceability, and access to information across science and operations teams.
              </p>
              <div class="proj-year">2025</div>
            </article>

            <article class="proj-card proj-item" id="ypsat">
              <h3 class="proj-h3-item">YPSat</h3>
              <div class="proj-subtle">Flight software · Launch operations · Autonomous event detection</div>
              <p class="proj-desc">
                Contribution to a technology demonstrator flown on <span class="hl">Ariane 6</span>,
                supporting mission context and project-facing documentation and analysis.
              </p>
              <div class="proj-year">2024</div>
            </article>

            <a
              class="proj-card proj-item proj-card-link"
              id="lunar-spaceport"
              href="/projects/lunar-spaceport"
            >
              <h3 class="proj-h3-item">Lunar Spaceport</h3>
              <div class="proj-subtle">Lunar infrastructure · ISRU and sustainability</div>
              <p class="proj-desc">
                Concept and systems-level study focusing on sustainable surface operations, dust mitigation
                considerations, and integrated infrastructure planning.
              </p>
              <div class="proj-actions">
                <span class="link-btn link-btn--secondary">View project</span>
              </div>
              <div class="proj-year">2025</div>
            </a>
          </div>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>
