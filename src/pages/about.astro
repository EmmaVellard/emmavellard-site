---
import "../styles/about.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/NavBar.astro";
---

<BaseLayout
  title="About | Emma Vellard"
  description="Learn about Emma Vellard's background in planetary science, space systems engineering, lunar research, scientific instrumentation, and international mission teams."
>
  <Navbar />

  <main class="page page-about" id="main-content" tabindex="-1">
    <div class="about-bg"></div>

    <section class="about-shell">
      <div class="container">
        <div class="about-hero">
          <!-- LEFT -->
          <div>
            <h1 class="about-hello">
              Hello,<br />
              I’m <span class="about-name">Emma</span>!
            </h1>

            <div class="about-prose">
              <p>
                I am a planetary scientist and space systems engineer currently conducting research at <span class="highlight">NASA Jet Propulsion Laboratory</span> on the interiors of the Moon and icy worlds.
              </p>
              <p>
                My current work compares lunar composition scenarios and develops thermodynamic and geophysical models
                that connect interior structure to <span class="highlight">mission-relevant observables</span> and future measurements.
              </p>
              <p>
                Previously, I worked for two years at the <span class="highlight">European Space Agency (ESA)</span> on
                the JUICE and BepiColombo missions, contributing to science planning, planetary data analysis,
                coordinated observations, and mission knowledge systems.
              </p>
              <p>
                My background combines fundamental physics, planetary science, scientific instrumentation concepts,
                and the TAS ASTRO Advanced Master’s in Space Systems Engineering at ISAE-SUPAERO.
              </p>
            </div>

            <!-- CTA: same style as home (link-btn) -->
            <a class="link-btn" href="https://www.linkedin.com/in/emma-vellard" target="_blank" rel="noopener">
              View my LinkedIn
            </a>
          </div>

          <!-- RIGHT (photo + info card, unchanged “front block”) -->
          <div class="about-hero-right">
            <div class="photo-stage">
              <!-- no shapes behind -->
              <img class="photo-cutout" src="/images/portrait.webp" width="1290" height="1915" alt="Portrait of Emma Vellard" decoding="async" fetchpriority="high" />

              <div class="photo-info">
                <div class="photo-info-title">Now</div>

                <div class="photo-info-row">
                  <div class="photo-info-label">Location</div>
                  <div class="photo-info-value">NASA JPL, Pasadena</div>
                </div>

                <div class="photo-info-row">
                  <div class="photo-info-label">Current focus</div>
                  <div class="photo-info-value">Lunar and planetary interiors · Mission-relevant measurements</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- RESEARCH INTERESTS (with explanatory text) -->
        <section class="about-research">
          <header class="about-section-head">
            <h2 class="about-h2">Research interests</h2>
            <p class="about-muted">Research areas spanning planetary science, engineering, and mission operations.</p>
          </header>

          <div class="interest-grid-minimal">
            <div class="interest-min">
              <span class="interest-min-title">Lunar science and exploration</span>
              <span class="interest-min-text">
                Interior structure, composition, geophysical measurements, local resources, and science-driven exploration architectures.
              </span>
            </div>

            <div class="interest-min">
              <span class="interest-min-title">Scientific instrumentation and measurements</span>
              <span class="interest-min-text">
                Translating scientific questions into observables, measurement concepts, payload trades, and instrument performance needs.
              </span>
            </div>

            <div class="interest-min">
              <span class="interest-min-title">Scientific software, data and calibration</span>
              <span class="interest-min-text">
                Reproducible Python workflows for model validation, planetary data analysis, and interpretation of mission measurements.
              </span>
            </div>

            <div class="interest-min">
              <span class="interest-min-title">Mission science and multidisciplinary coordination</span>
              <span class="interest-min-text">
                Observation planning, science operations support, technical documentation, and collaboration across science and engineering teams.
              </span>
            </div>
          </div>
        </section>

        <!-- LANGUAGES (back to the previous minimal text style) -->
        <section class="about-languages">
          <header class="about-section-head">
            <h2 class="about-h2">Languages</h2>
            <p class="about-muted">Comfortable working in international research environments.</p>
          </header>

          <div class="language-grid-minimal" role="list">
            <div class="language-min" role="listitem">
              <span class="language-min-title">French</span>
              <span class="language-min-text">Native</span>
            </div>

            <div class="language-min" role="listitem">
              <span class="language-min-title">English</span>
              <span class="language-min-text">Fluent</span>
            </div>

            <div class="language-min" role="listitem">
              <span class="language-min-title">Japanese</span>
              <span class="language-min-text">Beginner</span>
            </div>

            <div class="language-min" role="listitem">
              <span class="language-min-title">Spanish</span>
              <span class="language-min-text">Intermediate</span>
            </div>
          </div>
        </section>

      </div>
    </section>
  </main>
</BaseLayout>
