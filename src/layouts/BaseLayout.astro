---
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/cormorant-garamond/700.css";
import "@fontsource/cormorant-upright/600.css";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";

type Props = {
  title: string;
  description?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
};

const {
  title,
  description = "Emma Vellard is a planetary scientist studying the interior of the Moon, from its composition and tides to its gravity and topography.",
  socialImage = "/og.jpg",
  socialImageAlt = "Emma Vellard — Lunar and planetary scientist",
  socialImageWidth = 1200,
  socialImageHeight = 630,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://www.emmavellard.com");
const socialImageURL = new URL(socialImage, canonicalURL);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Emma Vellard",
  url: "https://www.emmavellard.com",
  jobTitle: "Planetary Scientist",
  description,
  affiliation: {
    "@type": "Organization",
    name: "NASA Jet Propulsion Laboratory",
    url: "https://www.jpl.nasa.gov/",
  },
  sameAs: ["https://github.com/EmmaVellard", "https://www.linkedin.com/in/emma-vellard"],
  knowsAbout: [
    "Lunar science",
    "Planetary geophysics",
    "Planetary interiors",
    "Gravity and topography",
    "Scientific software",
    "Space systems engineering",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply the saved or system theme before first paint to avoid a flash of the wrong theme.
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef5fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07111f" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <link rel="icon" href="/favicon.ico?v=ev-ribbons-20261008" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" href="/favicon.png?v=ev-ribbons-20261008" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=ev-ribbons-20261008" sizes="180x180" />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <NavBar />
    <slot />
    <Footer />

    <!-- Vercel components render custom elements, which are not allowed in <head>:
         there they would end the head early and push the CSP <meta> into the body. -->
    <Analytics />
    <SpeedInsights />
  </body>
</html>
